msgstr "「何をしているか分かっているのか？」"

#: data/json/speech.json data/json/snippets/schizophrenia.json
msgid "\"Stop laughing at me!\""
msgstr "「笑うのを止めろ！」"

#: data/json/speech.json data/json/snippets/schizophrenia.json
msgid "\"Stay away from me!\""
msgstr "「あっちへ行け！」"

#: data/json/speech.json data/json/snippets/schizophrenia.json
msgid "\"It wasn't my fault!\""
msgstr "「私のせいじゃない！」"

#: data/json/speech.json data/json/snippets/schizophrenia.json
msgid "\"They made me do it!\""
msgstr "「命令されたんだ！」"

