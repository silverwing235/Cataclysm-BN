#: data/json/speech.json
msgid "\"Suspected felony!\""
msgstr "「重犯罪容疑！」"

#: data/json/speech.json
msgid "\"Suspected misdemeanor!\""
msgstr "「軽犯罪容疑！」"

#: data/json/speech.json
msgid "\"Do not reach for your pockets!\""
msgstr "「ポケットに手を近づけるな！」"

#: data/json/speech.json
msgid "\"Keep your hands up!\""
msgstr "「そのまま手を上げ続けろ！」"

#: data/json/speech.json
