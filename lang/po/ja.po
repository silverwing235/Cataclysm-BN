#: src/monattack.cpp
msgid "\"Stop it please\""
msgstr "「止めて下さい」"

#: src/monattack.cpp
msgid "\"Let us help you\""
msgstr "「貴方の力になります」"

#: src/monattack.cpp
msgid "\"We wish you no harm\""
