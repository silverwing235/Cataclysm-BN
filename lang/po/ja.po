msgstr "「抵抗を止めなさい！」"

#: data/json/speech.json
msgid "\"Code 10-66.  Copy 10-4.  Possible 10-55.\""
msgstr "「コード10-66。複製10-4。候補10-55」"

#: data/json/speech.json
msgid "\"Probable 10-70.\""
msgstr "「推定原因10-70」"

