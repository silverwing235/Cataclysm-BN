msgstr "鋼で作られた一箱分の小さな玉です。この玉はほとんどダメージを与えられません。"

#: data/json/items/ammo.json
msgid "feather"
msgid_plural "feathers"
msgstr[0] "羽根"

#. ~ Description for {'str': 'feather'}
#: data/json/items/ammo.json
msgid "Feathers from a bird.  Useful for fletching arrows."
msgstr "鳥の羽です。矢羽の材料に適しています。"

#: data/json/items/ammo.json
msgid "down feather"
msgid_plural "down feathers"
msgstr[0] "羽毛"

#. ~ Description for {'str': 'down feather'}
#: data/json/items/ammo.json
msgid "Fluffy down feathers from a bird.  Useful for making cozy bedclothes."
msgstr "鳥から採れる柔らかな綿羽です。寝心地の良い寝具の製作に使えます。"

#: data/json/items/ammo.json
msgid "120mm HEAT"
msgid_plural "120mm HEATs"
msgstr[0] "弾薬(120mm/HEAT)"

#. ~ Description for {'str': '120mm HEAT'}
#: data/json/items/ammo.json
msgid ""
"A 120mm high-explosive anti-tank round.  It could ruin anyone's whole day."
msgstr "120mm対戦車弾です。これを使えばどんな物でも破壊できそうです。"

#: data/json/items/ammo.json
msgid "hydrogen canister"
msgid_plural "hydrogen canisters"
msgstr[0] "水素キャニスター"

#. ~ Description for {'str': 'hydrogen canister'}
#: data/json/items/ammo.json
msgid ""
