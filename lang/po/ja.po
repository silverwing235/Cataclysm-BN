#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Don't use ranged weapons anymore."
msgstr "絶対に遠距離武器を使うな。"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "You can use ranged weapons."
msgstr "遠距離武器を使ってもいい。"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Don't worry about noise."
msgstr "音は気にしなくていい。"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Use only silent weapons."
msgstr "音の出ない武器だけを使え。"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Don't use grenades anymore."
msgstr "手榴弾を使うな。"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "You can use grenades."
msgstr "手榴弾を使っていいぞ。"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Don't worry about shooting an ally."
msgstr "味方を撃っても気にするな。"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Don't shoot unless you're sure you won't hit an ally."
msgstr "絶対に味方に当たらないように撃て。"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Move wherever you need to go to fight an enemy."
msgstr "必要なら敵の近くへ移動して戦え。"

#: data/json/npcs/TALK_COMMON_ALLY.json
msgid "Hold the line: don't move onto obstacles adjacent to me."
msgstr "後ろに下がるな。私の移動の邪魔になる地点へ移動するな。"

