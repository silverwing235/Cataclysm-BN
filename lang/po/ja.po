#: data/json/professions.json
msgctxt "profession_female"
msgid "Castaway"
msgstr ""

#. ~ Profession (male Castaway) description
#: data/json/professions.json
msgctxt "prof_desc_male"
msgid ""
"You were shipwrecked out on an island in the lake.  No one sent a search "
"party, so after weeks of trying to signal for help you salvaged every scrap "
