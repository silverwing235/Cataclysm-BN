"A 3-foot (or about 90 cm) long piece of plastic cord.  Useful for a variety "
"of purposes, but it's not as flexible as string."
msgstr ""

#: data/json/items/generic/string.json
msgid "short plastic cord"
msgid_plural "short plastic cords"
msgstr[0] ""

#. ~ Description for {'str': 'short plastic cord'}
#: data/json/items/generic/string.json
msgid ""
"A 6-inch (or about 15 cm) long piece of plastic cord.  Useful for a variety "
"of purposes, but it's not as flexible as string."
msgstr ""

#: data/json/items/generic/string.json
msgid "short string"
msgid_plural "short strings"
msgstr[0] "紐(15cm)"

#. ~ Description for {'str': 'short string'}
#: data/json/items/generic/string.json
msgid "A 6-inch (or about 15 cm) long piece of cotton string."
msgstr "長さ約15cmの綿製の紐です。"

#: data/json/items/generic/string.json
msgid "long string"
msgid_plural "long strings"
msgstr[0] "紐(90cm)"

#. ~ Description for {'str': 'long string'}
#: data/json/items/generic/string.json
msgid "A 3-foot (or about 90 cm) long piece of cotton string."
msgstr "長さ約90cmの綿製の紐です。"

#: data/json/items/generic/string.json
