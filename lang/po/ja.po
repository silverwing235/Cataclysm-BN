msgstr "次元間の境界空間から凝縮した物質です。"

#: data/mods/Aftershock/items/crafting_scrap/neural_io_scrap.json
msgid "peripheral electrode"
msgid_plural "peripheral electrodes"
msgstr[0] "末梢電極"

#. ~ Description for {'str': 'peripheral electrode'}
#: data/mods/Aftershock/items/crafting_scrap/neural_io_scrap.json
