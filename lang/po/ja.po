msgstr "素材として使用するために必要な化学処理を行った動物の毛皮です。使用することで毛皮を広げ、他の用途に使うことができます。"

#: data/json/obsoletion/items.json
msgid "tanned hide"
msgid_plural "tanned hides"
msgstr[0] "鞣革"

#. ~ Description for {'str': 'tanned hide'}
#: data/json/obsoletion/items.json
